{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Выберите ваш Prometheus источник данных",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__elements": {},
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "id": null,
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚦 Здоровье и Статус (Service Pulse)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Доступность Сервисов",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "targets": [{ "expr": "up{job=\"cinema-microservices\"}", "legendFormat": "{{instance}}", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DEAD" }, "1": { "color": "green", "text": "ONLINE" } }, "type": "value" }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Использование Heap Памяти (%)",
      "type": "gauge",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "targets": [{ "expr": "(sum by(instance) (jvm_memory_used_bytes{instance=~\"$instance\", area=\"heap\"}) / sum by(instance) (jvm_memory_max_bytes{instance=~\"$instance\", area=\"heap\"})) * 100", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "#EAB839", "value": 70 }, { "color": "red", "value": 85 }] }
        }
      }
    },
    {
      "id": 3,
      "title": "Очередь за коннектом к БД (Pending Threads)",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "targets": [{ "expr": "sum by(instance) (hikaricp_connections_pending{instance=~\"$instance\"})", "legendFormat": "{{instance}}", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "🌐 Трафик, Задержки и Ошибки (HTTP Golden Signals)",
      "type": "row"
    },
    {
      "id": 4,
      "title": "RPS по Кодам Ответа",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum by (instance, status) (rate(http_server_requests_seconds_count{instance=~\"$instance\"}[1m]))", "legendFormat": "{{instance}} [{{status}}]", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "gradientMode": "opacity" },
          "unit": "reqps"
        }
      }
    },
    {
      "id": 5,
      "title": "Задержка (Latency p95 & p99)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(http_server_requests_seconds_bucket{instance=~\"$instance\"}[1m])))", "legendFormat": "{{instance}} (p95)", "refId": "A" },
        { "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(http_server_requests_seconds_bucket{instance=~\"$instance\"}[1m])))", "legendFormat": "{{instance}} (p99)", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 6,
      "title": "Процент Ошибок (5xx Error Rate)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "targets": [{ "expr": "(sum by(instance) (rate(http_server_requests_seconds_count{status=~\"5..\", instance=~\"$instance\"}[1m])) / sum by(instance) (rate(http_server_requests_seconds_count{instance=~\"$instance\"}[1m]))) * 100", "legendFormat": "{{instance}} Errors %", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "fillOpacity": 30, "gradientMode": "opacity" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "🗄️ База Данных: Пул Подключений HikariCP",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Состояние Подключений HikariCP (Active vs Idle vs Max)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        { "expr": "hikaricp_connections_active{instance=~\"$instance\"}", "legendFormat": "{{instance}} - Активные", "refId": "A" },
        { "expr": "hikaricp_connections_idle{instance=~\"$instance\"}", "legendFormat": "{{instance}} - Простаивают", "refId": "B" },
        { "expr": "hikaricp_connections_max{instance=~\"$instance\"}", "legendFormat": "{{instance}} - Лимит (Max)", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 8,
      "title": "Время ожидания коннекта к БД (Connection Acquire Time p95)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(hikaricp_connections_acquire_seconds_bucket{instance=~\"$instance\"}[1m])))", "legendFormat": "{{instance}} acquire p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "⚙️ Внутренности JVM (GC & Threads)",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Паузы Garbage Collection (GC Pauses/sec)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [{ "expr": "rate(jvm_gc_pause_seconds_sum{instance=~\"$instance\"}[1m])", "legendFormat": "{{instance}} GC time/sec", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 10,
      "title": "Активные потоки (Live Threads)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "jvm_threads_live_threads{instance=~\"$instance\"}", "legendFormat": "{{instance}} Live", "refId": "A" },
        { "expr": "jvm_threads_peak_threads{instance=~\"$instance\"}", "legendFormat": "{{instance}} Peak", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" } }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cinema-app", "enterprise"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(up{job=\"cinema-microservices\"}, instance)",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "label": "Сервис",
        "multi": true,
        "name": "instance",
        "query": "label_values(up{job=\"cinema-microservices\"}, instance)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Cinema App: Enterprise Cockpit",
  "uid": "cinema-app-enterprise"
}