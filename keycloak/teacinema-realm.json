{
  "realm": "teacinema",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "defaultRoles": [
    "USER"
  ],
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Обычный зритель"
      },
      {
        "name": "ADMIN",
        "description": "Администратор кинотеатра"
      }
    ]
  },
  "clients": [
    {
      "clientId": "teacinema-backend-client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin@cinema.dev",
      "enabled": true,
      "email": "admin@cinema.dev",
      "firstName": "Cinema",
      "lastName": "Admin",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_CINEMA_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "USER"
      ]
    }
  ]
}