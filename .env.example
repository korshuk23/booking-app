# ==============================================================================
# INFRASTRUCTURE SECRETS & CREDENTIALS
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuperCinemaSecurePass2026!
POSTGRES_PORT=5432
DB_HOST=localhost

# ------------------------------------------------------------------------------
# 2. CACHE & IN-MEMORY STORE (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. MESSAGE BROKER (Apache Kafka)
# ------------------------------------------------------------------------------
KAFKA_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_RETRY_ATTEMPTS=3
KAFKA_RETRY_INTERVAL_MS=1000


# ------------------------------------------------------------------------------
# 4. IDENTITY PROVIDER (Keycloak)
# ------------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_HOST=localhost
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=SuperAdminKeycloakPass2026!
KEYCLOAK_CLIENT_SECRET=cinema-secret-key-12345
# Секрет для генерации персональных детерминированных HMAC-SHA256 паролей пользователей
KEYCLOAK_HMAC_SECRET=teacinema-super-secret-hmac-master-key-2026

# ------------------------------------------------------------------------------
# 5. SERVICE DISCOVERY & GATEWAY
# ------------------------------------------------------------------------------
DISCOVERY_PORT=8761
GATEWAY_PORT=8088
EUREKA_HOST=localhost
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & TELEMETRY (Prometheus, Tempo, Loki, Grafana)
# ------------------------------------------------------------------------------
TEMPO_HOST=localhost
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
GRAFANA_PORT=3000
LOKI_PORT=3100

# ------------------------------------------------------------------------------
# 7. BUSINESS LOGIC & TUNING (MAGIC NUMBERS ELIMINATED)
# ------------------------------------------------------------------------------
# Длина OTP-кода и время жизни в Redis (в секундах)
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRATION_SEC=300
AUTH_OTP_LOG_CODE=true

# Cinema Booking TTL
SEAT_RESERVATION_TIMEOUT_MIN=15
SEAT_RELEASE_JOB_RATE_MS=60000

# Outbox Settings
OUTBOX_PUBLISHER_DELAY_MS=1000
OUTBOX_RETENTION_DAYS=3
OUTBOX_CLEANUP_CRON=0 0 * * * *

# SSE & Cache
BOOKING_SSE_TIMEOUT_MS=60000
MOVIE_CACHE_TTL_MIN=10