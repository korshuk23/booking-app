# ==============================================================================
# CINEMA PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# ИНСТРУКЦИЯ:
# 1. Скопируйте этот файл как .env: cp .env.example .env
# 2. В .env замените дефолтные пароли на собственные безопасные значения.
# 3. Файл .env добавлен в .gitignore и НИКОГДА не должен попадать в Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5432
DB_HOST=localhost

# ------------------------------------------------------------------------------
# 2. REDIS (Cache & Distributed Locks)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. APACHE KAFKA
# ------------------------------------------------------------------------------
# Внутри Docker-сети: kafka:9092
# С хост-машины (локальный запуск из IDEA): localhost:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_RETRY_ATTEMPTS=3
KAFKA_RETRY_INTERVAL_MS=1000

# ------------------------------------------------------------------------------
# 4. IDENTITY PROVIDER (Keycloak)
# ------------------------------------------------------------------------------
KEYCLOAK_HOST=localhost
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
# Секрет клиента backend-приложения в Realm "teacinema"
KEYCLOAK_CLIENT_SECRET=cinema-secret-key-12345
# Дефолтный технический пароль для пользователей, создаваемых через OTP-флоу
KEYCLOAK_USER_DEFAULT_PASSWORD=default-secure-password-123

# ------------------------------------------------------------------------------
# 5. SERVICE DISCOVERY (Eureka)
# ------------------------------------------------------------------------------
EUREKA_HOST=localhost
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & TRACING (Tempo / OTLP)
# ------------------------------------------------------------------------------
TEMPO_HOST=localhost

# ------------------------------------------------------------------------------
# 7. BUSINESS LOGIC & MAGIC NUMBERS TUNING
# ------------------------------------------------------------------------------
# Auth Service: Длина одноразового пароля и время его жизни (в секундах)
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRATION_SEC=300

# Movie Service: Таймаут брони кресла (минуты) и частота проверки зависших мест (мс)
SEAT_RESERVATION_TIMEOUT_MIN=15
SEAT_RELEASE_JOB_RATE_MS=60000

# Movie Service: Время жизни кэша списка фильмов в Redis (в минутах)
MOVIE_CACHE_TTL_MIN=10

# Booking Service: Таймаут SSE-соединения для стриминга статуса брони (мс)
BOOKING_SSE_TIMEOUT_MS=60000

# Transactional Outbox: Задержка поллера (мс), хранение отправленных событий (дни) и крон очистки
OUTBOX_PUBLISHER_DELAY_MS=1000
OUTBOX_RETENTION_DAYS=3
OUTBOX_CLEANUP_CRON=0 0 * * * *